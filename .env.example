# Copy this file to ".env" for local development (netlify dev / vercel dev).
# NEVER commit your real secret key. In production, set these in your host's
# dashboard (Netlify: Site settings > Environment; Vercel: Project > Settings > Environment Variables).

# Your Stripe SECRET key (server-side only). Test key starts with sk_test_
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Your site's public URL. Used to build Checkout success/cancel links.
SITE_URL=http://localhost:8888
